{
    "name": "lordnaz/arcutra-v2",
    "description": "Arcutra V2 website",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "serve": "@php -S 127.0.0.1:8080 -t . router.php",
        "test": [
            "@php tests/contact-form-test.php",
            "node --check assets/home.js",
            "node --check assets/product.js",
            "node --check assets/contact.js",
            "node tests/preloader-test.mjs",
            "node tests/http-regression.mjs",
            "node tests/http-regression.mjs accept",
            "node tests/http-regression.mjs reject",
            "node tests/http-regression.mjs client-reject",
            "node tests/http-regression.mjs team-partial",
            "node tests/http-regression.mjs stall"
        ]
    }
}
